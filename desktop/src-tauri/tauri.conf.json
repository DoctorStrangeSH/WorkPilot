{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Malenia",
  "version": "0.2.1",
  "identifier": "com.workpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Malenia",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "category": "Utility",
    "shortDescription": "Локальный рабочий помощник",
    "longDescription": "Malenia — локальный помощник для задач и безопасной автоматизации.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ]
      }
    }
  }
}